# CopyLingo Environment Variables File (.env)
# ----------------------------------------------------
# `cp .env.example .env` 후 값을 채우십시오. Host에서 서버를 실행하는 로컬 개발용입니다.
# .env 값은 기존 shell 환경변수보다 우선합니다.
# 배포 환경(docker compose, 클라우드)에는 .env가 없고, 같은 이름의 환경변수를 플랫폼이 주입합니다.

# ---- 필수: 비어 있으면 서버가 시작되지 않습니다 ----

# Telegram Bot Token (@BotFather 발급)
COPYLINGO_TELEGRAM_TOKEN=123456789:ABCDefghijklmnopqrstuvwxyz

# Gemini API Key (손글씨 채점, Q&A, TTS)
COPYLINGO_LLM_API_KEY=

# `make infra`로 띄운 로컬 컨테이너 접속 정보
COPYLINGO_DB_HOST=localhost
COPYLINGO_DB_USER=copylingo
COPYLINGO_DB_PASSWORD=copylingo
COPYLINGO_DB_DBNAME=copylingo
COPYLINGO_DB_SSLMODE=disable
COPYLINGO_REDIS_ADDR=localhost:6379
COPYLINGO_STORAGE_REGION=ap-northeast-2
COPYLINGO_STORAGE_BUCKET=copylingo-audio
COPYLINGO_STORAGE_ACCESS_KEY=minioadmin
COPYLINGO_STORAGE_SECRET_KEY=minioadmin

# ---- 선택: 비우면 빈 값 / false / 0 으로 동작 ----

# MinIO용 설정. AWS S3를 쓸 때는 둘 다 비웁니다.
COPYLINGO_STORAGE_ENDPOINT=http://localhost:9000
COPYLINGO_STORAGE_USE_PATH_STYLE=true

# Mini App 공개 HTTPS URL. `make tunnel`이 자동으로 기록합니다.
# COPYLINGO_SERVER_PUBLIC_BASE_URL=

# ---- 기본값 변경 (기본값: internal/config/load.go의 defaults) ----
# COPYLINGO_LLM_MODEL=gemini-3.5-flash-lite
# COPYLINGO_TELEGRAM_DEBUG=true
# COPYLINGO_LOGGING_LEVEL=INFO
